# Định dạng dùng chung cho IDE (IntelliJ / VS Code đọc file này).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[pom.xml]
# pom.xml sinh từ Spring Initializr dùng tab — giữ nguyên để diff gọn.
indent_style = tab

[*.md]
trim_trailing_whitespace = false
